# Base URL of the t3leem API (server-side only — never exposed to the browser).
# Local: the API from the repo root (`npm run dev`). Vercel: the t3leem-api deployment URL.
API_URL=http://localhost:3000

# Public URL of this site, printed in certificate QR codes.
PUBLIC_WEB_URL=http://localhost:3001
# Hosts that are the platform itself (not custom academy domains). Comma-separated.
PLATFORM_HOSTS=localhost,127.0.0.1,t3leem.my,www.t3leem.my
