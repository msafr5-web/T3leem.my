// t3leem.my — core schema.
// Every tenant-owned table carries tenant_id (even child tables such as modules/lessons)
// so a single uniform RLS policy can guard it without joins. See prisma/rls/001_enable_rls.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  INSTRUCTOR
  LEARNER
}

enum CourseType {
  RECORDED
  LIVE
}

enum ContentType {
  VIDEO
  ZOOM
  PDF
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CompletionStatus {
  ENROLLED
  COMPLETED
}

enum PaymentMethod {
  MADA
  CREDIT_CARD
  APPLE_PAY
  STC_PAY
}

enum InvoiceStatus {
  PENDING_ZATCA
  REPORTED
  REJECTED
}

// Tenant registry. Intentionally NOT under RLS: it is read before a tenant context exists
// (subdomain / custom-domain resolution).
model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  slug          String       @unique
  customDomain  String?      @unique @map("custom_domain")
  brandSettings Json         @default("{}") @map("brand_settings")
  status        TenantStatus @default(PROVISIONING)
  // ZATCA seller identity (TLV tags 1 and 2).
  legalName     String?      @map("legal_name")
  vatNumber     String?      @map("vat_number") @db.VarChar(15)
  planId        String?      @map("plan_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  plan SaasPlan? @relation(fields: [planId], references: [id])

  @@map("tenants")
}

model SaasPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  maxStudents  Int      @map("max_students")
  maxStorageGb Int      @map("max_storage_gb")
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  tenants Tenant[]

  @@map("saas_plans")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  email             String
  passwordHash      String   @map("password_hash")
  role              UserRole @default(LEARNER)
  // AES-256-GCM ciphertext (iv:tag:data, base64). Never store plaintext National ID / Iqama.
  nationalIdOrIqama String?  @map("national_id_or_iqama")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  enrollments Enrollment[]
  courses     Course[]     @relation("CourseInstructor")

  @@unique([tenantId, email])
  @@map("users")
}

model Course {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  instructorId String     @map("instructor_id") @db.Uuid
  title        String
  type         CourseType
  // VAT-exclusive price in SAR.
  price        Decimal    @db.Decimal(12, 2)
  isPublished  Boolean    @default(false) @map("is_published")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  instructor  User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules     Module[]
  enrollments Enrollment[]

  @@index([tenantId, isPublished])
  @@map("courses")
}

model Module {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  title     String
  sortOrder Int    @map("sort_order")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@map("modules")
}

model Lesson {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  moduleId    String      @map("module_id") @db.Uuid
  title       String
  contentType ContentType @map("content_type")
  mediaUrl    String?     @map("media_url")
  meetingData Json?       @map("meeting_data")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  courseId           String           @map("course_id") @db.Uuid
  status             EnrollmentStatus @default(ACTIVE)
  progressPercentage Decimal          @default(0) @map("progress_percentage") @db.Decimal(5, 2)
  completionStatus   CompletionStatus @default(ENROLLED) @map("completion_status")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  course       Course        @relation(fields: [courseId], references: [id])
  certificates Certificate[]
  invoices     Invoice[]

  @@unique([tenantId, userId, courseId])
  @@map("enrollments")
}

model Certificate {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  enrollmentId    String   @map("enrollment_id") @db.Uuid
  certificateCode String   @unique @map("certificate_code")
  qrCodeUrl       String?  @map("qr_code_url")
  pdfUrl          String?  @map("pdf_url")
  issuedAt        DateTime @default(now()) @map("issued_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("certificates")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  enrollmentId     String?       @map("enrollment_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  invoiceNumber    String        @map("invoice_number")
  issuedAt         DateTime      @map("issued_at")
  currency         String        @default("SAR") @db.Char(3)
  subtotalAmount   Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  vatAmount        Decimal       @map("vat_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentReference String        @map("payment_reference")
  // Filled by the zatca-sync worker after XML signing (Phase 2 invoice hash + cryptographic stamp).
  zatcaHash        String?       @map("zatca_hash")
  zatcaQr          String        @map("zatca_qr")
  status           InvoiceStatus @default(PENDING_ZATCA)
  createdAt        DateTime      @default(now()) @map("created_at")

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

// Gap-free per-tenant, per-year invoice numbering (ZATCA requires sequential numbers).
model InvoiceSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  year      Int
  lastValue Int    @map("last_value")

  @@id([tenantId, year])
  @@map("invoice_sequences")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  UserRole @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
