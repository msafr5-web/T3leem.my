// t3leem.my — core schema.
// Every tenant-owned table carries tenant_id (even child tables such as modules/lessons)
// so a single uniform RLS policy can guard it without joins. See prisma/rls/001_enable_rls.sql.

generator client {
  provider      = "prisma-client-js"
  // native = local machine; rhel-openssl-3.0.x = Vercel / AWS Lambda (Node 20+) runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime: t3leem_app (DML only, subject to RLS).
  url       = env("DATABASE_URL")
  // Migrations: t3leem_owner (DDL). Used by the Prisma CLI only, never by the API.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  INSTRUCTOR
  LEARNER
}

enum CourseType {
  RECORDED
  LIVE
}

enum ContentType {
  VIDEO
  ZOOM
  PDF
  // A time range (start_second..end_second) of the course's source YouTube video.
  YOUTUBE
}

enum QuizQuestionType {
  MCQ
  TEXT
  // Several right options (all-or-nothing).
  CHECKBOX
  // One-line written answer (reviewed, not auto-graded).
  SHORT
  // 1-5 stars (collected, not graded).
  RATING
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CompletionStatus {
  ENROLLED
  COMPLETED
}

enum PaymentMethod {
  MADA
  CREDIT_CARD
  APPLE_PAY
  STC_PAY
}

enum InvoiceStatus {
  PENDING_ZATCA
  REPORTED
  REJECTED
}

enum PlanType {
  TRAINING
  DEVELOPMENT
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MeetingProvider {
  ZOOM
  TEAMS
  GOOGLE_MEET
  OTHER
}

enum ClassroomStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum HlsStatus {
  NONE
  PROCESSING
  READY
  FAILED
}

// Tenant registry. Intentionally NOT under RLS: it is read before a tenant context exists
// (subdomain / custom-domain resolution).
model Tenant {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String       @unique
  customDomain           String?      @unique @map("custom_domain")
  // DNS TXT challenge for the custom domain; the domain only routes once verified.
  customDomainToken      String?      @map("custom_domain_token")
  customDomainVerifiedAt DateTime?    @map("custom_domain_verified_at")
  brandSettings          Json         @default("{}") @map("brand_settings")
  status                 TenantStatus @default(PROVISIONING)
  // ZATCA seller identity (TLV tags 1 and 2).
  legalName              String?      @map("legal_name")
  vatNumber              String?      @map("vat_number") @db.VarChar(15)
  // Small raster logo (PNG/JPEG/WebP, <= 512 KB) stored in-row until object storage (S3) is wired.
  logo                   Bytes?
  logoMimeType           String?      @map("logo_mime_type")
  logoUpdatedAt          DateTime?    @map("logo_updated_at")
  planId                 String?      @map("plan_id") @db.Uuid
  // Subscription managed by the platform owner: approval time, end of the paid period (null = no end) and the modules switched on.
  approvedAt             DateTime?    @map("approved_at")
  subscriptionEndsAt     DateTime?    @map("subscription_ends_at")
  features               Json         @default("{\"health\":true,\"recorded\":true}")
  // Who signed the academy up (the first admin), for the owner console and WhatsApp follow-up.
  ownerName              String?      @map("owner_name")
  ownerEmail             String?      @map("owner_email")
  ownerPhone             String?      @map("owner_phone")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  plan          SaasPlan?      @relation(fields: [planId], references: [id])
  healthSetting HealthSetting?

  @@map("tenants")
}

// A provider sign-up waiting for its e-mail code. The tenant and its admin are created only once
// the code is confirmed, so nobody can claim an address or an academy name with someone else's e-mail.
model SignupVerification {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  slug         String
  academyName  String   @map("academy_name")
  city         String?
  adminName    String   @map("admin_name")
  phone        String?
  passwordHash String   @map("password_hash")
  codeHash     String   @map("code_hash")
  attempts     Int      @default(0)
  sends        Int      @default(1)
  lastSentAt   DateTime @default(now()) @map("last_sent_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([slug])
  @@map("signup_verifications")
}

// One-time e-mail code that signs a user in. tenant_id null = the platform owner console.
// Not tenant-scoped by RLS: a challenge is found by its unguessable id and always checked against the request tenant.
model LoginOtp {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  email      String
  userId     String?  @map("user_id") @db.Uuid
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0)
  sends      Int      @default(1)
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_otps")
}

model SaasPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  maxStudents  Int      @map("max_students")
  maxStorageGb Int      @map("max_storage_gb")
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  tenants Tenant[]

  @@map("saas_plans")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  email             String
  fullName          String?  @map("full_name")
  passwordHash      String   @map("password_hash")
  role              UserRole @default(LEARNER)
  // AES-256-GCM ciphertext (iv:tag:data, base64). Never store plaintext National ID / Iqama.
  nationalIdOrIqama String?  @map("national_id_or_iqama")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  enrollments     Enrollment[]
  trainer         Trainer?
  discussionPosts DiscussionPost[]
  quizAttempts    QuizAttempt[]
  healthStates    HealthUserState[]
  healthSessions  HealthSession[]
  healthAccess    HealthEntitlement?

  @@unique([tenantId, email])
  @@map("users")
}

// A provider's trainer. Can exist without a login account (userId null): providers list
// their trainers by name first and invite them to the platform later.
model Trainer {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  fullName       String   @map("full_name")
  specialization String?
  bio            String?
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User?              @relation(fields: [userId], references: [id])
  courses    Course[]
  classrooms VirtualClassroom[]

  @@index([tenantId])
  @@map("trainers")
}

model Course {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @map("tenant_id") @db.Uuid
  trainerId             String     @map("trainer_id") @db.Uuid
  title                 String
  description           String?
  type                  CourseType
  // VAT-exclusive price in SAR.
  price                 Decimal    @db.Decimal(12, 2)
  // Regulatory metadata (e.g. TVTC / SCFHS): license issued for the course and its accreditation.
  licenseNumber         String?    @map("license_number")
  licenseAuthority      String?    @map("license_authority")
  licenseExpiresOn      DateTime?  @map("license_expires_on") @db.Date
  accreditationNumber   String?    @map("accreditation_number")
  trainingHours         Decimal?   @map("training_hours") @db.Decimal(6, 1)
  durationDays          Int?       @map("duration_days")
  // Recorded courses built from one YouTube video: the source and the schedule settings
  // (lecture/break/discussion minutes) used to split it into days and segments.
  sourceVideoId         String?    @map("source_video_id")
  sourceDurationSeconds Int?       @map("source_duration_seconds")
  scheduleConfig        Json?      @map("schedule_config")
  // The channel the video comes from (shown to learners as the source) and when day 1 opens;
  // day N opens N-1 days later at the same time (the lecture time).
  sourceChannelUrl      String?    @map("source_channel_url")
  sourceChannelName     String?    @map("source_channel_name")
  scheduleStartsAt      DateTime?  @map("schedule_starts_at") @db.Timestamptz(3)
  // End-of-day quiz: how long the learner has and how many random questions are drawn.
  quizDurationMinutes   Int        @default(10) @map("quiz_duration_minutes")
  quizQuestionCount     Int        @default(3) @map("quiz_question_count")
  isPublished           Boolean    @default(false) @map("is_published")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  trainer       Trainer              @relation(fields: [trainerId], references: [id])
  modules       Module[]
  enrollments   Enrollment[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]
  plans         TrainingPlanCourse[]
  classrooms    VirtualClassroom[]

  @@index([tenantId, isPublished])
  @@map("courses")
}

// A provider's training or development plan: an ordered program of courses over a period.
model TrainingPlan {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  title       String
  description String?
  type        PlanType
  status      PlanStatus @default(DRAFT)
  startsOn    DateTime?  @map("starts_on") @db.Date
  endsOn      DateTime?  @map("ends_on") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  courses TrainingPlanCourse[]

  @@index([tenantId, status])
  @@map("training_plans")
}

model TrainingPlanCourse {
  tenantId  String @map("tenant_id") @db.Uuid
  planId    String @map("plan_id") @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  sortOrder Int    @map("sort_order")

  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([planId, courseId])
  @@map("training_plan_courses")
}

// A scheduled live session. joinUrl is entered manually for now; the Zoom integration
// (live module) will create meetings and fill it automatically.
model VirtualClassroom {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  courseId          String?         @map("course_id") @db.Uuid
  trainerId         String?         @map("trainer_id") @db.Uuid
  title             String
  startsAt          DateTime        @map("starts_at")
  durationMinutes   Int             @map("duration_minutes")
  capacity          Int?
  provider          MeetingProvider @default(ZOOM)
  joinUrl           String?         @map("join_url")
  // Meeting id at the provider (Zoom) when the meeting was created through the API.
  externalMeetingId String?         @map("external_meeting_id")
  status            ClassroomStatus @default(SCHEDULED)
  createdAt         DateTime        @default(now()) @map("created_at")

  course     Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  trainer    Trainer?              @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  attendance ClassroomAttendance[]

  @@index([tenantId, startsAt])
  @@map("virtual_classrooms")
}

model LessonProgress {
  tenantId     String   @map("tenant_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  completedAt  DateTime @default(now()) @map("completed_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, lessonId])
  @@map("lesson_progress")
}

// Attendance recorded from Zoom's meeting.participant_joined webhook.
model ClassroomAttendance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  classroomId      String   @map("classroom_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  // Email when Zoom provides it, otherwise Zoom's participant id — one row per person per classroom.
  participantKey   String   @map("participant_key")
  participantName  String   @map("participant_name")
  participantEmail String?  @map("participant_email")
  joinedAt         DateTime @map("joined_at")

  classroom VirtualClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, participantKey])
  @@map("classroom_attendance")
}

// Global lookups that must work BEFORE a tenant context exists, so NOT under RLS.
// They hold only non-sensitive pointers; the actual records stay tenant-isolated.

/**
 * Public certificate verification: code -> which academy to look in.
 */
model CertificateRegistry {
  code          String   @id
  tenantId      String   @map("tenant_id") @db.Uuid
  certificateId String   @unique @map("certificate_id") @db.Uuid
  issuedAt      DateTime @default(now()) @map("issued_at")

  @@map("certificate_registry")
}

/**
 * Zoom webhooks carry only the meeting id: meeting -> academy + classroom.
 */
model MeetingRegistry {
  externalMeetingId String   @id @map("external_meeting_id")
  tenantId          String   @map("tenant_id") @db.Uuid
  classroomId       String   @unique @map("classroom_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("meeting_registry")
}

model Module {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  title        String
  sortOrder    Int       @map("sort_order")
  // Window in which the day quiz can be started / must be finished (null = no limit).
  quizOpensAt  DateTime? @map("quiz_opens_at") @db.Timestamptz(3)
  quizClosesAt DateTime? @map("quiz_closes_at") @db.Timestamptz(3)

  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  discussions   DiscussionPost[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  @@index([courseId, sortOrder])
  @@map("modules")
}

// Per-day (module) discussion board: learners ask, trainers/admins answer (one reply level).
model DiscussionPost {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  module  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  DiscussionPost?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies DiscussionPost[] @relation("DiscussionReplies")

  @@index([moduleId, createdAt])
  @@map("discussion_posts")
}

// Question bank of a course (imported from Excel). moduleId = the day it belongs to;
// null = shared pool used by every day that has no questions of its own.
model QuizQuestion {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  moduleId       String?          @map("module_id") @db.Uuid
  code           String
  body           String
  type           QuizQuestionType
  options        Json             @default("[]")
  correctAnswer  String           @map("correct_answer")
  // CHECKBOX only: the texts of every right option.
  correctOptions Json             @default("[]") @map("correct_options")
  points         Int              @default(1)
  required       Boolean          @default(false)
  difficulty     QuizDifficulty   @default(MEDIUM)
  sortOrder      Int              @default(0) @map("sort_order")
  createdAt      DateTime         @default(now()) @map("created_at")

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@unique([courseId, code])
  @@index([courseId, moduleId])
  @@map("quiz_questions")
}

// One learner's single attempt at a day's quiz. The drawn questions (with their shuffled
// options) are frozen in `questions`; the deadline is decided by the server, never the client.
model QuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime  @map("expires_at")
  submittedAt DateTime? @map("submitted_at")
  questions   Json
  answers     Json      @default("{}")
  score       Int?
  maxScore    Int?      @map("max_score")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([courseId, moduleId])
  @@map("quiz_attempts")
}

model Lesson {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  moduleId        String      @map("module_id") @db.Uuid
  title           String
  contentType     ContentType @map("content_type")
  sortOrder       Int         @default(0) @map("sort_order")
  mediaUrl        String?     @map("media_url")
  meetingData     Json?       @map("meeting_data")
  // HLS (AES-128) pipeline state for VIDEO lessons.
  hlsStatus       HlsStatus   @default(NONE) @map("hls_status")
  // The 16-byte content key, sealed with FIELD_ENCRYPTION_KEY (AES-256-GCM). Never stored in clear.
  hlsKeyEncrypted String?     @map("hls_key_encrypted")
  hlsError        String?     @map("hls_error")
  durationSeconds Int?        @map("duration_seconds")
  // YOUTUBE lessons: the segment of the course's source video this lesson plays.
  startSecond     Int?        @map("start_second")
  endSecond       Int?        @map("end_second")

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  courseId           String           @map("course_id") @db.Uuid
  status             EnrollmentStatus @default(ACTIVE)
  progressPercentage Decimal          @default(0) @map("progress_percentage") @db.Decimal(5, 2)
  completionStatus   CompletionStatus @default(ENROLLED) @map("completion_status")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id])
  course       Course           @relation(fields: [courseId], references: [id])
  certificates Certificate[]
  invoices     Invoice[]
  progress     LessonProgress[]

  @@unique([tenantId, userId, courseId])
  @@map("enrollments")
}

model Certificate {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  enrollmentId    String   @unique @map("enrollment_id") @db.Uuid
  certificateCode String   @unique @map("certificate_code")
  qrCodeUrl       String?  @map("qr_code_url")
  pdfUrl          String?  @map("pdf_url")
  issuedAt        DateTime @default(now()) @map("issued_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("certificates")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  enrollmentId     String?       @map("enrollment_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  invoiceNumber    String        @map("invoice_number")
  issuedAt         DateTime      @map("issued_at")
  currency         String        @default("SAR") @db.Char(3)
  subtotalAmount   Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  vatAmount        Decimal       @map("vat_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentReference String        @map("payment_reference")
  // Filled by the zatca-sync worker after XML signing (Phase 2 invoice hash + cryptographic stamp).
  zatcaHash        String?       @map("zatca_hash")
  zatcaQr          String        @map("zatca_qr")
  status           InvoiceStatus @default(PENDING_ZATCA)
  createdAt        DateTime      @default(now()) @map("created_at")

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

// Gap-free per-tenant, per-year invoice numbering (ZATCA requires sequential numbers).
model InvoiceSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  year      Int
  lastValue Int    @map("last_value")

  @@id([tenantId, year])
  @@map("invoice_sequences")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  UserRole @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---- Health certificates academy (practice question bank per sector) ----

// One row per tenant: switch, free-trial end and the fee that applies after it (null = free).
model HealthSetting {
  tenantId    String    @id @map("tenant_id") @db.Uuid
  enabled     Boolean   @default(true)
  trialEndsAt DateTime? @map("trial_ends_at")
  price       Decimal?  @db.Decimal(12, 2)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("health_settings")
}

model HealthSector {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  slug      String
  name      String
  title     String   @default("")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  questions HealthQuestion[]
  sessions  HealthSession[]

  @@unique([tenantId, slug])
  @@map("health_sectors")
}

model HealthQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sectorId     String   @map("sector_id") @db.Uuid
  code         String
  body         String
  // 2-6 option texts; correctIndex points into this list.
  options      Json
  correctIndex Int      @map("correct_index")
  explanation  String   @default("")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  sector HealthSector      @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  states HealthUserState[]

  @@unique([tenantId, code])
  @@index([sectorId, active])
  @@map("health_questions")
}

model HealthUserState {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  isFavorite Boolean  @default(false) @map("is_favorite")
  isRead     Boolean  @default(false) @map("is_read")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question HealthQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@map("health_user_states")
}

model HealthSession {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  sectorId        String?  @map("sector_id") @db.Uuid
  clientSessionId String   @map("client_session_id")
  total           Int
  correct         Int
  createdAt       DateTime @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector HealthSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  @@unique([userId, clientSessionId])
  @@index([userId, createdAt])
  @@map("health_sessions")
}

// Paid access after the trial (granted by the provider until online payment is wired).
model HealthEntitlement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("health_entitlements")
}
