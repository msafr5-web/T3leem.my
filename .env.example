NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# `npm run db:setup` fills in everything below marked (setup).
# API role (DML only) — must NOT be a superuser or have BYPASSRLS, otherwise RLS is silently skipped. (setup)
DATABASE_URL=postgresql://t3leem_app:change-me@localhost:5432/t3leem?schema=public&connection_limit=10
# Schema owner, used by Prisma migrations only. (setup)
DIRECT_DATABASE_URL=postgresql://t3leem_owner:change-me@localhost:5432/t3leem?schema=public
# Isolated database for the RLS integration tests. (setup)
TEST_DATABASE_URL=postgresql://t3leem_app:change-me@localhost:5432/t3leem_test?schema=public
TEST_DIRECT_DATABASE_URL=postgresql://t3leem_owner:change-me@localhost:5432/t3leem_test?schema=public
REDIS_URL=redis://localhost:6379

# Tenants resolve from <slug>.BASE_DOMAIN when no x-tenant-id header is sent.
BASE_DOMAIN=t3leem.my
CORS_ORIGINS=http://localhost:5173

# RS256 public key (PEM, base64-encoded on one line). The private key lives only in the auth signer. (setup)
JWT_PUBLIC_KEY_BASE64=
# Development only — used by `npm run token:dev`. (setup)
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_ISSUER=t3leem.my
JWT_AUDIENCE=t3leem.my/api

VAT_RATE_PERCENT=15
# Only "sandbox" is implemented; it is refused when NODE_ENV=production.
PAYMENT_GATEWAY=sandbox

RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SEC=60
