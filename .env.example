NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Application role — must NOT be a superuser or have BYPASSRLS, otherwise RLS is silently skipped.
DATABASE_URL=postgresql://t3leem_app:change-me@localhost:5432/t3leem
REDIS_URL=redis://localhost:6379

# Tenants resolve from <slug>.BASE_DOMAIN when no x-tenant-id header is sent.
BASE_DOMAIN=t3leem.my
CORS_ORIGINS=http://localhost:5173

# RS256 public key (PEM, base64-encoded on one line). The private key lives only in the auth signer.
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=t3leem.my
JWT_AUDIENCE=t3leem.my/api

VAT_RATE_PERCENT=15
# Only "sandbox" is implemented; it is refused when NODE_ENV=production.
PAYMENT_GATEWAY=sandbox

RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SEC=60
