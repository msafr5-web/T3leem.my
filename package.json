{
  "name": "t3leem-backend",
  "version": "0.1.0",
  "private": true,
  "description": "t3leem.my — multi-tenant cloud training SaaS backend (modular monolith)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/db/setup.ps1",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "node scripts/db/with-test-db.mjs npx prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "token:dev": "tsx --env-file=.env scripts/dev/issue-token.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^5.0.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
